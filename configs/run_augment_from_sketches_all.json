{
  "$schema": "./run.schema.json",
  "run_id": "run_augment_from_sketches_all",
  "dataset_root": "dataset",
  "ids": null,
  "provider": "openai",
  "model": "gpt-5.4",
  "prompt_template": "augment_from_sketch_html",
  "mode": "augment_from_sketch",
  "dataset_output_dir": "references",
  "generation": {
    "temperature": 0,
    "max_tokens": 128000
  },
  "output": {
    "root": "runs",
    "overwrite": false
  },
  "retry": {
    "max_attempts": 5,
    "initial_backoff_seconds": 2,
    "max_backoff_seconds": 120,
    "backoff_multiplier": 2
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "file": true
  }
}
