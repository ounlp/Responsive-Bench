C-M1/M2: Modal dialog + focus trap + close
(implement if modal trigger button visible in screenshots)
──────────────────────────────────────────────────────────────────────────────
HTML structure required:
  <button id="modal-trigger" aria-haspopup="dialog">Open [purpose]</button>

  <div
    id="modal-[id]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title-[id]"
    hidden>
    <h2 id="modal-title-[id]">[Modal purpose]</h2>
    [modal content]
    <button id="modal-close-[id]" aria-label="Close [modal purpose]">&#x2715;</button>
  </div>
  <div id="modal-backdrop" hidden aria-hidden="true"></div>

JS behavior (full focus trap):
  function openModal(modal, trigger) {
    modal.hidden = false;
    document.getElementById('modal-backdrop').hidden = false;
    document.body.setAttribute('aria-hidden', 'true');
    modal.removeAttribute('aria-hidden');
    const focusable = modal.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    focusable[0].focus();

    modal._trap = (e) => {
      if (e.key !== 'Tab') return;
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    };
    modal._esc = (e) => { if (e.key === 'Escape') closeModal(modal, trigger); };
    modal.addEventListener('keydown', modal._trap);
    document.addEventListener('keydown', modal._esc);
    modal._trigger = trigger;
  }

  function closeModal(modal, trigger) {
    modal.hidden = true;
    document.getElementById('modal-backdrop').hidden = true;
    document.body.removeAttribute('aria-hidden');
    modal.removeEventListener('keydown', modal._trap);
    document.removeEventListener('keydown', modal._esc);
    (modal._trigger || trigger).focus();
  }

