C-F1/F3: Form validation + error announcement
(implement if F1 or F3 in applicable_criteria)
──────────────────────────────────────────────────────────────────────────────
HTML structure required:
  <form novalidate>
    <div class="field-group">
      <label for="email">Email address <span aria-hidden="true">*</span></label>
      <input
        type="email"
        id="email"
        name="email"
        required
        aria-describedby="email-error"
        aria-invalid="false">
      <span id="email-error" role="alert" aria-live="assertive" hidden></span>
    </div>
    <div aria-live="polite" id="form-status" class="sr-only"></div>
    <button type="submit">Submit</button>
  </form>

JS behavior:
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let firstError = null;

    form.querySelectorAll('[required]').forEach(input => {
      const errorEl = document.getElementById(input.getAttribute('aria-describedby'));
      if (!input.value.trim()) {
        input.setAttribute('aria-invalid', 'true');
        errorEl.textContent = `${input.labels[0].textContent.trim()} is required`;
        errorEl.hidden = false;
        if (!firstError) firstError = input;
      } else {
        input.setAttribute('aria-invalid', 'false');
        errorEl.hidden = true;
        errorEl.textContent = '';
      }
    });

    if (firstError) {
      firstError.focus();
    } else {
      document.getElementById('form-status').textContent = 'Form submitted successfully.';
    }
  });

