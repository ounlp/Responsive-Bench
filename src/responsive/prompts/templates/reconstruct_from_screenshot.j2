C-N1: Hamburger menu  (implement if visible on mobile screenshot)
──────────────────────────────────────────────────────────────────────────────
HTML structure required:
  <button
    id="nav-toggle"
    aria-expanded="false"
    aria-controls="mobile-nav"
    aria-label="Open navigation menu"
    class="nav-toggle">
    <span aria-hidden="true">&#9776;</span>
  </button>
  <nav id="mobile-nav" aria-label="Main" hidden>
    ...nav items...
  </nav>

JS behavior:
  const toggle = document.getElementById('nav-toggle');
  const nav    = document.getElementById('mobile-nav');

  toggle.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    toggle.setAttribute('aria-label', expanded ? 'Open navigation menu'
                                               : 'Close navigation menu');
    nav.hidden = expanded;
    if (!expanded) {
      nav.querySelector('a, button').focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.hidden === false) {
      nav.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      toggle.focus();
    }
  });

CSS required:
  .nav-toggle { display: none; }
  @media (max-width: 768px) { .nav-toggle { display: block; } }

