C-M3: Toast notification  (implement if toast/snackbar area visible in screenshots)
──────────────────────────────────────────────────────────────────────────────
HTML structure required:
  <div
    id="toast-region"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    class="toast-region">
  </div>

JS behavior:
  function showToast(message, duration = 5000) {
    const region = document.getElementById('toast-region');
    region.textContent = message;
    region.hidden = false;
    setTimeout(() => {
      region.textContent = '';
      region.hidden = true;
    }, duration);
  }

