# Copy to .env and fill in the keys for the providers you use.

# Generation and judging (the paper's judge is GPT-5.4 via the "openai" provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# "vllm" provider: OpenAI-compatible server, e.g. http://localhost:8000/v1
VLLM_BASE_URL=

# "modal" provider: OpenAI-compatible endpoint deployed on modal.com
MODAL_ENDPOINT=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
