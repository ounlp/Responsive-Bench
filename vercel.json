{
  "buildCommand": "python scripts/build_runs_data.py 2>/dev/null || true; cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "devCommand": "cd frontend && npm run dev",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/runs", "destination": "/index.html" },
    { "source": "/runs/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
